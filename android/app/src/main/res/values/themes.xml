<resources>
    <!-- Compose supplies the real UI theme via MaterialTheme; the platform theme
         only needs to drop the action bar and system window decorations. Using the
         platform Material theme avoids pulling in the AppCompat/Material XML deps. -->
    <style name="Theme.DotCompanion" parent="android:Theme.Material.Light.NoActionBar" />
</resources>
